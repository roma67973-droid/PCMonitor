<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms нужен только для NotifyIcon (значок в трее). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PCMonitor</AssemblyName>
    <RootNamespace>PCMonitor</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Для локальной отладки без UAC: dotnet build -p:AsInvoker=true -->
    <ApplicationManifest Condition="'$(AsInvoker)' == 'true'">app.asinvoker.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <!-- Нужно генератору [LibraryImport] для P/Invoke без маршалинга во время выполнения. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Приложение живёт в трее неделями: минимум памяти важнее пропускной способности GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <DebugType>embedded</DebugType>
    <!-- WFAC010: анализатор WinForms просит задавать DPI через API WinForms; для WPF-приложения правильное место — манифест. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Не тянем WinForms/GDI в глобальные using — конфликтуют с WPF-типами. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PCMonitor.Tests" />
  </ItemGroup>

</Project>
