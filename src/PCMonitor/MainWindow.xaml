<Window x:Class="PCMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:PCMonitor.Controls"
        xmlns:v="clr-namespace:PCMonitor.Views"
        xmlns:vm="clr-namespace:PCMonitor.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="PC Monitor" Width="1220" Height="800" MinWidth="1060" MinHeight="660"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" Icon="Assets/app.ico"
        c:Motion.IsEnabled="{Binding Settings.Animations}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Боковая панель ═══ -->
            <Border Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,22,0,30">
                        <!-- Векторный логотип: чёткий на любом DPI, кольцо в цветах темы -->
                        <Grid Width="38" Height="38">
                            <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource CardBrush}"/>
                            <c:RingGauge Width="25" Height="25" Margin="0,2.5,0,0" Value="74" Thickness="2.6"
                                         Brush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource TrackBrush}"/>
                            <Path Data="M0,5 L3.8,5 L5.7,0.1 L8.4,9.6 L10.3,3.5 L13,3.5" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2.5,0,0"/>
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PC Monitor" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="мониторинг · кулеры · экран" Style="{StaticResource Sub}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Мини-сводка внизу панели -->
                    <Border DockPanel.Dock="Bottom" Margin="16" Padding="14,12" CornerRadius="12" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" DataContext="{Binding Overview}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="CPU" Style="{StaticResource Sub}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock c:RollingText.Text="{Binding CpuTempText}" Foreground="{Binding CpuTempSeverity, Converter={StaticResource SeverityToBrush}}"
                                           FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding CpuLoad, Mode=OneWay}" Height="4" Margin="0,4,0,10"/>
                            <DockPanel>
                                <TextBlock Text="GPU" Style="{StaticResource Sub}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock c:RollingText.Text="{Binding GpuTempText}" Foreground="{Binding GpuTempSeverity, Converter={StaticResource SeverityToBrush}}"
                                           FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding GpuLoad, Mode=OneWay}" Height="4" Margin="0,4,0,10"/>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Sub}" FontSize="11.5" Margin="8,0,0,0"><Run Text="Программа: "/><Run Text="{Binding Status.AppMemoryText, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Плашка выбранного пункта переезжает между пунктами (см. SlidingHighlight). -->
                    <c:SlidingHighlight Fill="{DynamicResource CardBrush}" Indicator="{DynamicResource AccentBrush}"
                                        CornerRadius="10" Inset="12,2,12,2">
                        <StackPanel>
                            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Обзор"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:AppPage.Overview}}"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9CA;" Content="Кулеры"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:AppPage.Fans}}"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE706;" Content="Экран"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:AppPage.Display}}"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="История"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:AppPage.History}}"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE790;" Content="Темы"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:AppPage.Themes}}"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Настройки"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:AppPage.Settings}}"/>
                        </StackPanel>
                    </c:SlidingHighlight>
                </DockPanel>
            </Border>

            <!-- ═══ Контент ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" Margin="28,22,0,0" VerticalAlignment="Top"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="OnMinimizeClick" ToolTip="Свернуть"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Content="&#xE922;" Click="OnMaximizeClick" ToolTip="Развернуть"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnCloseClick" ToolTip="Закрыть"/>
                </StackPanel>

                <!-- Страницы создаются один раз; переключается только видимость (см. MainWindow.ShowPage). -->
                <Grid x:Name="Pages" Grid.Row="1">
                    <v:OverviewPage Tag="{x:Static vm:AppPage.Overview}" DataContext="{Binding Overview}"/>
                    <v:FansPage Tag="{x:Static vm:AppPage.Fans}" DataContext="{Binding Fans}"/>
                    <v:DisplayPage Tag="{x:Static vm:AppPage.Display}" DataContext="{Binding Display}"/>
                    <v:HistoryPage Tag="{x:Static vm:AppPage.History}" DataContext="{Binding History}"/>
                    <v:ThemesPage Tag="{x:Static vm:AppPage.Themes}" DataContext="{Binding Themes}"/>
                    <v:SettingsPage Tag="{x:Static vm:AppPage.Settings}" DataContext="{Binding Settings}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
