<UserControl x:Class="PCMonitor.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:PCMonitor.Controls"
             xmlns:core="clr-namespace:PCMonitor.Core"
             xmlns:vm="clr-namespace:PCMonitor.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HistoryViewModel}">

    <UserControl.Resources>
        <Style x:Key="SummaryCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock" BasedOn="{StaticResource Big}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,0,20,24">
            <DockPanel Margin="8,0,8,6">
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                    <c:SlidingHighlight Fill="{DynamicResource SelectionBrush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="1 час" IsChecked="{Binding RangeMinutes, Converter={StaticResource Equals}, ConverterParameter=60}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="6 часов" IsChecked="{Binding RangeMinutes, Converter={StaticResource Equals}, ConverterParameter=360}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="Сутки" IsChecked="{Binding RangeMinutes, Converter={StaticResource Equals}, ConverterParameter=1440}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="Неделя" IsChecked="{Binding RangeMinutes, Converter={StaticResource Equals}, ConverterParameter=10080}"/>
                        </StackPanel>
                    </c:SlidingHighlight>
                </Border>
                <Border Style="{StaticResource SegmentHost}">
                    <c:SlidingHighlight Fill="{DynamicResource SelectionBrush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="Температура" IsChecked="{Binding ShowLoad, Converter={StaticResource Equals}, ConverterParameter=False}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="Нагрузка" IsChecked="{Binding ShowLoad, Converter={StaticResource Equals}, ConverterParameter=True}"/>
                        </StackPanel>
                    </c:SlidingHighlight>
                </Border>
            </DockPanel>

            <UniformGrid Columns="4">
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Максимум CPU" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding CpuPeakText}" Style="{StaticResource SummaryValue}" Foreground="{Binding CpuPeakSeverity, Converter={StaticResource SeverityToBrush}}"/>
                        <TextBlock Text="{Binding CpuPeakDetails}" Style="{StaticResource Sub}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Максимум GPU" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding GpuPeakText}" Style="{StaticResource SummaryValue}" Foreground="{Binding GpuPeakSeverity, Converter={StaticResource SeverityToBrush}}"/>
                        <TextBlock Text="{Binding GpuPeakDetails}" Style="{StaticResource Sub}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="В перегреве" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding OverheatText}" Style="{StaticResource SummaryValue}" Foreground="{Binding OverheatSeverity, Converter={StaticResource SeverityToBrush}}"/>
                        <TextBlock Text="{Binding OverheatDetails}" Style="{StaticResource Sub}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Средняя нагрузка" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding AverageLoadText}" Style="{StaticResource SummaryValue}"/>
                        <TextBlock Text="процессор / видеокарта" Style="{StaticResource Sub}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Border Width="14" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="CPU" Style="{StaticResource Sub}" Margin="6,0,16,0"/>
                            <Border Width="14" Height="4" CornerRadius="2" Background="{DynamicResource Accent2Brush}" VerticalAlignment="Center"/>
                            <TextBlock Text="GPU" Style="{StaticResource Sub}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="График" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0"
                                       Text="Линия — среднее за минуту, полупрозрачный коридор — пиковые значения. Наведите мышь, чтобы увидеть точные цифры."/>
                        </StackPanel>
                    </DockPanel>
                    <c:HistoryChart Height="360" Points="{Binding Points}" RangeMinutes="{Binding RangeMinutes}" ShowLoad="{Binding ShowLoad}"
                                    OverheatThreshold="{x:Static core:Thermals.CpuOverheat}"
                                    CpuBrush="{DynamicResource AccentBrush}" GpuBrush="{DynamicResource Accent2Brush}" GridBrush="{DynamicResource TrackBrush}"
                                    TextBrush="{DynamicResource SubTextBrush}" HotBrush="{DynamicResource HotBrush}" TooltipBrush="{DynamicResource CardHoverBrush}"/>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Sub}" Margin="8,4,8,0" TextWrapping="Wrap"
                       Text="История пишется всё время, пока программа запущена (в том числе в трее), и хранится 7 дней в файле history.bin рядом с программой."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
