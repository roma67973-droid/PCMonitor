<UserControl x:Class="PCMonitor.Views.StatusBanners"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PCMonitor.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SystemStatusViewModel}">

    <!-- Предупреждения о недоступных датчиках. DataContext — SystemStatusViewModel. -->
    <UserControl.Resources>
        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="8,0,8,8"/>
        </Style>
        <Style x:Key="BannerIcon" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE7BA;"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource Banner}" Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock Style="{StaticResource BannerIcon}"/>
                <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13">
                    <Run FontWeight="SemiBold" Text="Нет прав администратора."/>
                    <Run Text="Температуры CPU и кулеры материнской платы недоступны. Запустите программу от имени администратора."/>
                </TextBlock>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Banner}" Visibility="{Binding ShowPawnIoBanner, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock Style="{StaticResource BannerIcon}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Скачать PawnIO" Margin="12,0,0,0"
                        Command="{Binding OpenPawnIoPageCommand}"/>
                <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13">
                    <Run FontWeight="SemiBold" Text="Нужен драйвер PawnIO."/>
                    <Run Text="Без него не видны температура CPU и кулеры материнской платы. Установите его один раз и перезапустите программу."/>
                </TextBlock>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
