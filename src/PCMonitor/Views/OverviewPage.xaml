<UserControl x:Class="PCMonitor.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:PCMonitor.Controls"
             xmlns:v="clr-namespace:PCMonitor.Views"
             xmlns:vm="clr-namespace:PCMonitor.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OverviewViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,0,20,20">

            <!-- Строка статуса -->
            <StackPanel Orientation="Horizontal" Margin="8,0,8,10" DataContext="{Binding Status}">
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" Opacity="0.35"/>
                            <Ellipse Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" Width="6" Height="6"/>
                        </Grid>
                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <TextBlock FontSize="12.5"><Run Text="&#xE916;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource AccentBrush}"/><Run Text="  Без перезагрузки " Foreground="{DynamicResource SubTextBrush}"/><Run Text="{Binding UptimeText, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                </Border>
                <TextBlock Text="Инициализация датчиков…" Style="{StaticResource Sub}" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <v:StatusBanners DataContext="{Binding Status}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Badge="CPU" Title="{Binding CpuName}"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="140" Height="140" HorizontalAlignment="Left">
                                <c:RingGauge Value="{Binding CpuLoad}" Thickness="8" Brush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource TrackBrush}"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock c:RollingText.Text="{Binding CpuLoad, StringFormat={}{0:0}}" Style="{StaticResource Big}"/>
                                        <TextBlock Text="%" Style="{StaticResource Sub}" FontSize="15" Margin="2,0,0,6" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Text="нагрузка" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Grid.Column="1" Columns="2" VerticalAlignment="Center">
                                <c:StatTile Label="Температура" Value="{Binding CpuTempText}" ValueBrush="{Binding CpuTempSeverity, Converter={StaticResource SeverityToBrush}}"/>
                                <c:StatTile Label="Частота" Value="{Binding CpuClockText}"/>
                                <c:StatTile Label="Мощность" Value="{Binding CpuPowerText}"/>
                                <c:StatTile Label="Потоков" Value="{Binding ThreadCountText, Mode=OneTime}"/>
                            </UniformGrid>
                        </Grid>
                        <TextBlock Text="Загрузка ядер" Style="{StaticResource Sub}" Margin="0,16,0,8"/>
                        <ItemsControl ItemsSource="{Binding Cores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:CoreLoadViewModel">
                                    <StackPanel Margin="2,0">
                                        <Grid Height="38">
                                            <Border CornerRadius="4" Background="{DynamicResource TrackBrush}"/>
                                            <Border CornerRadius="4" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}"
                                                    Height="{Binding Load, Converter={StaticResource PercentToLength}, ConverterParameter=38}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Sub}" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <c:Sparkline Height="56" Margin="0,12,0,0" Values="{Binding CpuSparkline}" Stroke="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Badge="GPU" Title="{Binding GpuName}"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="140" Height="140" HorizontalAlignment="Left">
                                <c:RingGauge Value="{Binding GpuLoad}" Thickness="8" Brush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource TrackBrush}"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock c:RollingText.Text="{Binding GpuLoad, StringFormat={}{0:0}}" Style="{StaticResource Big}"/>
                                        <TextBlock Text="%" Style="{StaticResource Sub}" FontSize="15" Margin="2,0,0,6" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Text="нагрузка" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Grid.Column="1" Columns="2" VerticalAlignment="Center">
                                <c:StatTile Label="Температура" Value="{Binding GpuTempText}" ValueBrush="{Binding GpuTempSeverity, Converter={StaticResource SeverityToBrush}}"/>
                                <c:StatTile Label="Hot Spot" Value="{Binding GpuHotSpotText}"/>
                                <c:StatTile Label="Ядро" Value="{Binding GpuClockText}"/>
                                <c:StatTile Label="Память" Value="{Binding GpuMemoryClockText}"/>
                                <c:StatTile Label="Мощность" Value="{Binding GpuPowerText}"/>
                                <c:StatTile Label="Вентилятор" Value="{Binding GpuFanText}"/>
                            </UniformGrid>
                        </Grid>
                        <DockPanel Margin="0,16,0,8">
                            <TextBlock Text="Видеопамять" Style="{StaticResource Sub}"/>
                            <TextBlock Text="{Binding VramText}" Style="{StaticResource Sub}" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Bar}" Value="{Binding VramLoad, Mode=OneWay}" Height="8"/>
                        <c:Sparkline Height="56" Margin="0,16,0,0" Values="{Binding GpuSparkline}" Stroke="{DynamicResource Accent2Brush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- ОЗУ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Badge="RAM" Title="Оперативная память"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="104" Height="104">
                                <c:RingGauge Value="{Binding RamLoad}" Thickness="7" Brush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource TrackBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock c:RollingText.Text="{Binding RamLoad, StringFormat={}{0:0}}" Style="{StaticResource Big}" FontSize="24"/>
                                    <TextBlock Text="%" Style="{StaticResource Sub}" Margin="1,0,0,5" VerticalAlignment="Bottom"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Занято" Style="{StaticResource Sub}"/>
                                <TextBlock Text="{Binding RamUsedText}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Свободно" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
                                <TextBlock c:RollingText.Text="{Binding RamFreeText}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Grid>
                        <c:Sparkline Height="48" Margin="0,14,0,0" Values="{Binding RamSparkline}" Stroke="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Сеть -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Badge="NET" Title="Сеть"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Sub}"><Run Text="↓" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/><Run Text=" Загрузка"/></TextBlock>
                                <TextBlock c:RollingText.Text="{Binding NetDownText}" Style="{StaticResource StatValue}" FontSize="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Sub}"><Run Text="↑" Foreground="{DynamicResource Accent2Brush}" FontWeight="Bold"/><Run Text=" Отдача"/></TextBlock>
                                <TextBlock c:RollingText.Text="{Binding NetUpText}" Style="{StaticResource StatValue}" FontSize="20"/>
                            </StackPanel>
                        </Grid>
                        <Grid Height="86" Margin="0,16,0,0">
                            <c:Sparkline Values="{Binding NetDownSparkline}" Maximum="0" Stroke="{DynamicResource AccentBrush}"/>
                            <c:Sparkline Values="{Binding NetUpSparkline}" Maximum="0" Stroke="{DynamicResource Accent2Brush}" FillOpacity="0.15"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Кулеры (кратко) -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <c:CardHeader DockPanel.Dock="Top" Badge="FAN" Title="Кулеры">
                            <Button Style="{StaticResource Link}" Content="Настроить →" Command="{Binding OpenFansCommand}"/>
                        </c:CardHeader>
                        <TextBlock DockPanel.Dock="Top" Text="Кулеры не найдены" Style="{StaticResource Sub}" Margin="0,16,0,0"
                                   Visibility="{Binding Fans.HasFans, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding Fans.Items}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:FanViewModel">
                                    <DockPanel Margin="0,5">
                                        <Path Data="{StaticResource FanGeometry}" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold">
                                            <Run Text="{Binding RpmText, Mode=OneWay}"/><Run Text=" об/мин" Foreground="{DynamicResource SubTextBrush}" FontWeight="Normal" FontSize="11"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Накопители -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Badge="SSD" Title="Накопители"/>
                    <ItemsControl ItemsSource="{Binding Disks}" Margin="-4,12,-4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DiskViewModel">
                                <Border Style="{StaticResource Stat}" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <DockPanel Margin="0,8,0,6">
                                            <TextBlock Style="{StaticResource Sub}"><Run Text="Темп. "/><Run Text="{Binding TemperatureText, Mode=OneWay}" Foreground="{Binding TemperatureSeverity, Mode=OneWay, Converter={StaticResource SeverityToBrush}}" FontWeight="SemiBold"/></TextBlock>
                                            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Right"><Run Text="Активность "/><Run Text="{Binding ActivityText, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/></TextBlock>
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource Bar}" Value="{Binding UsedPercent, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding UsedText}" Style="{StaticResource Sub}" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
