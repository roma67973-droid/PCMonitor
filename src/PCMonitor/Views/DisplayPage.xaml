<UserControl x:Class="PCMonitor.Views.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:PCMonitor.Controls"
             xmlns:vm="clr-namespace:PCMonitor.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DisplayViewModel}">

    <UserControl.Resources>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Sub}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="SliderLabel" TargetType="TextBlock" BasedOn="{StaticResource Sub}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="SliderValue" TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- Значки по краям ползунка: маленький — «меньше», большой — «больше» (как в ElasticSlider из react-bits). -->
        <Style x:Key="EdgeIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Ползунок-«шкала»: окрашена вся дорожка (кисть — в Tag), так сразу видно, что меняется. -->
        <Style x:Key="ScaleSlider" TargetType="Slider" BasedOn="{StaticResource AccentSlider}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="26">
                            <Border Height="8" CornerRadius="4" VerticalAlignment="Center" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderEmpty}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="{DynamicResource TextBrush}" Stroke="{DynamicResource CardBrush}" StrokeThickness="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитка быстрого режима. Фон выбранной рисует SlidingHighlight вокруг ряда. -->
        <Style x:Key="PresetTile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="DisplayPreset"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Margin="4" Padding="16,14" CornerRadius="12" Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="Desc" Text="{Binding Description}" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,2,0,0"
                                               TextWrapping="Wrap" TextTrimming="None"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SubTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="DimScale" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3A4060" Offset="0"/>
            <GradientStop Color="#000000" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WarmScale" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E8EEFF" Offset="0"/>
            <GradientStop Color="#FFD9A0" Offset="0.55"/>
            <GradientStop Color="#FF9A3C" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20,0,20,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ Быстрые режимы ═══ -->
            <Border Grid.ColumnSpan="2" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="есть и в меню значка в трее" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                        <TextBlock Text="Быстрые режимы" Style="{StaticResource CardTitle}"/>
                    </DockPanel>
                    <c:SlidingHighlight Fill="{DynamicResource SelectionBrush}" CornerRadius="12" Inset="4" Margin="-4,10,-4,-4">
                        <ItemsControl ItemsSource="{Binding PresetOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PresetOptionViewModel">
                                    <RadioButton Style="{StaticResource PresetTile}" IsChecked="{Binding IsActive}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </c:SlidingHighlight>
                </StackPanel>
            </Border>

            <!-- ═══ Мониторы: настоящая подсветка по DDC/CI ═══ -->
            <StackPanel Grid.Row="1">
                <Border Style="{StaticResource Card}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Ищу мониторы…" Style="{StaticResource Hint}"/>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding HasNoMonitors, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Найти заново" Command="{Binding RescanCommand}"/>
                        <TextBlock Text="Мониторы не найдены." Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Monitors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:MonitorViewModel">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="10,5" FontSize="12"
                                                Content="Найти заново" ToolTip="Заново найти мониторы (после подключения или смены кабеля)"
                                                Command="{Binding DataContext.RescanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        <c:CardHeader Badge="DDC" Title="{Binding Name}"/>
                                    </DockPanel>

                                    <!-- Не управляется: одна строка с подсказкой -->
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Foreground="{DynamicResource WarnBrush}" Margin="0,14,0,0"
                                               Visibility="{Binding IsSupported, Converter={StaticResource InverseBoolToVisibility}}"/>

                                    <Grid Margin="0,18,0,0" Visibility="{Binding IsSupported, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="152"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Кольцо яркости, как кольца нагрузки на «Обзоре» -->
                                        <Grid Width="136" Height="136" HorizontalAlignment="Left">
                                            <c:RingGauge Value="{Binding Brightness}" Thickness="8" Brush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource TrackBrush}"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE706;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Brightness}" Style="{StaticResource Big}" FontSize="28"/>
                                                    <TextBlock Text="%" Style="{StaticResource Sub}" FontSize="14" Margin="2,0,0,5" VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                                <TextBlock Text="яркость" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Brightness, StringFormat={}{0}%}" Style="{StaticResource SliderValue}"/>
                                                <TextBlock Text="Яркость подсветки" Style="{StaticResource SliderLabel}"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,4,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="&#xE706;" FontSize="11" Style="{StaticResource EdgeIcon}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE706;" FontSize="18" Style="{StaticResource EdgeIcon}"/>
                                                <Slider Style="{StaticResource AccentSlider}" Value="{Binding Brightness}" Margin="4,0"/>
                                            </DockPanel>

                                            <StackPanel Visibility="{Binding HasContrast, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Contrast, StringFormat={}{0}%}" Style="{StaticResource SliderValue}"/>
                                                    <TextBlock Text="Контраст" Style="{StaticResource SliderLabel}"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Text="◐" FontFamily="{StaticResource UiFont}" FontSize="11" Style="{StaticResource EdgeIcon}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="◐" FontFamily="{StaticResource UiFont}" FontSize="18" Style="{StaticResource EdgeIcon}"/>
                                                    <Slider Style="{StaticResource AccentSlider}" Value="{Binding Contrast}" Margin="4,0"/>
                                                </DockPanel>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarnBrush}" Margin="0,8,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ═══ Фильтры поверх изображения ═══ -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <c:CardHeader Badge="FX" Title="Фильтры"/>
                    <TextBlock Text="Работают на любом экране. Действуют и при закрытом окне, сбрасываются при выходе."
                               Style="{StaticResource Hint}" Margin="0,8,0,0"/>

                    <DockPanel Margin="0,20,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DimPercent, StringFormat={}{0}%}" Style="{StaticResource SliderValue}"/>
                        <TextBlock Text="Затемнение" Style="{StaticResource SliderLabel}"/>
                    </DockPanel>
                    <Slider Style="{StaticResource ScaleSlider}" Tag="{StaticResource DimScale}" Value="{Binding DimPercent}" Margin="0,4,0,0"/>
                    <TextBlock Text="Темнее, чем позволяет подсветка. В играх может снижать FPS."
                               Style="{StaticResource Hint}" FontSize="11.5" Margin="0,4,0,0"/>

                    <DockPanel Margin="0,20,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding WarmthPercent, StringFormat={}{0}%}" Style="{StaticResource SliderValue}"/>
                        <TextBlock Text="Тёплый оттенок" Style="{StaticResource SliderLabel}"/>
                    </DockPanel>
                    <Slider Style="{StaticResource ScaleSlider}" Tag="{StaticResource WarmScale}" Value="{Binding WarmthPercent}" Margin="0,4,0,0"/>
                    <TextBlock Text="Убирает синий свет, как «Ночной свет» Windows. Играм не мешает."
                               Style="{StaticResource Hint}" FontSize="11.5" Margin="0,4,0,0"/>
                    <TextBlock Text="Видеокарта не приняла изменение цвета (так бывает при включённом HDR)."
                               Style="{StaticResource Hint}" Foreground="{DynamicResource WarnBrush}" Margin="0,8,0,0"
                               Visibility="{Binding WarmthRejected, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
